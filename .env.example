# Copy to `.env` and paste a key. This file is read by the Node side of the dev
# server only (vite.config.ts -> server/mimic-strategist.mjs); it is never
# bundled into the browser build, and `.env` is gitignored.
#
# Set EITHER key. If both are set, Anthropic wins unless MIMIC_PROVIDER says
# otherwise. Without any key the game still runs — MIMIC uses its local learning
# model and the HUD shows "MIMIC LINK: LOCAL".
#
#   ANTHROPIC_API_KEY -> HUD shows "CLAUDE"  (keys look like sk-ant-...)
#   OPENAI_API_KEY    -> HUD shows "GPT"     (keys look like sk-proj-... / sk-...)

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Force one provider even when both keys are present: anthropic | openai
MIMIC_PROVIDER=

# Optional. Overrides the default OpenAI model (gpt-4o-mini). Must support
# structured outputs (response_format json_schema with strict: true).
OPENAI_MODEL=
